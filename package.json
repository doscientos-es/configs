{
  "name": "@doscientos/configs",
  "version": "0.1.6",
  "private": false,
  "description": "Fast, strict, and reusable engineering standards for Doscientos projects.",
  "homepage": "https://github.com/doscientos-es/configs#readme",
  "bugs": {
    "url": "https://github.com/doscientos-es/configs/issues"
  },
  "license": "MIT",
  "author": "Doscientos <dev@doscientos.es>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doscientos-es/configs.git"
  },
  "bin": {
    "doscientos-structure": "./structure/check-structure.mjs"
  },
  "files": [
    "*.d.ts",
    "*.js",
    "*.json",
    "structure",
    "tsconfig",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./architecture": {
      "types": "./feature-layers.d.ts",
      "import": "./feature-layers.js"
    },
    "./oxlint/astro": {
      "types": "./astro.d.ts",
      "import": "./astro.js"
    },
    "./oxfmt": "./oxfmt.json",
    "./oxlint/base": {
      "types": "./base.d.ts",
      "import": "./base.js"
    },
    "./oxlint/node": {
      "types": "./node.d.ts",
      "import": "./node.js"
    },
    "./oxlint/react-vite": {
      "types": "./react-vite.d.ts",
      "import": "./react-vite.js"
    },
    "./oxlint/react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./oxlint/react-next": {
      "types": "./react-next.d.ts",
      "import": "./react-next.js"
    },
    "./oxlint/typescript": {
      "types": "./typescript.d.ts",
      "import": "./typescript.js"
    },
    "./oxlint/typescript-strict": {
      "types": "./typescript-strict.d.ts",
      "import": "./typescript-strict.js"
    },
    "./structure": "./structure/check-structure.mjs",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/strict": "./tsconfig/strict.json",
    "./vitest": {
      "types": "./vitest.d.ts",
      "import": "./vitest.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --test test/config.test.mjs",
    "format": "oxfmt -c oxfmt.json --write .",
    "format:check": "oxfmt -c oxfmt.json --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "prepublishOnly": "npm run check",
    "quality": "pnpm format:check && pnpm lint && pnpm check",
    "release:check": "pnpm run check && npm pack --dry-run",
    "version:major": "npm version major --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "oxlint": ">=1.75.0 <2",
    "oxlint-tsgolint": ">=7.0.2001",
    "vitest": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@9.15.2"
}
